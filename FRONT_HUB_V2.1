		function() setSize(ctx.Settings.UIScale - 0.1) end, function() setSize(ctx.Settings.UIScale + 0.1) end)

	local info = UI.card(scroll, 96)
	UI.label(info, string.format("%s  v%s", CONFIG.Name, CONFIG.Version), {
		Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 20), TextSize = 15, Font = UI.fontBold,
	})
	UI.label(info, "RightShift ou bouton FH : ouvrir / fermer le menu\nF : fly ON/OFF\nTout est local : seul toi vois ce que fait ce menu.", {
		Position = UDim2.new(0, 14, 0, 32), Size = UDim2.new(1, -28, 0, 58), TextSize = 12, TextColor3 = c.dim,
	})

	local killCard = UI.card(scroll, 58)
	local killBtn = UI.button(killCard, "FERMER ET SUPPRIMER LE HUB", {
		Position = UDim2.new(0, 12, 0, 12), Size = UDim2.new(1, -24, 0, 34), TextSize = 13,
	})
