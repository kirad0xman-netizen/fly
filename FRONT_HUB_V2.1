local function PagePlayer(ctx, parent)
	local UI = ctx.UI
	local c = UI.colors
	local group, scroll = UI.page(parent)
	local startTime = os.time()

	local function infoCard(title, height)
		local card = UI.card(scroll, height)
		UI.label(card, title, {
			Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 16), TextSize = 12, TextColor3 = c.dim,
		})
		local body = UI.label(card, "", { Position = UDim2.new(0, 14, 0, 30), Size = UDim2.new(1, -28, 1, -38), TextSize = 13 })
		body.LineHeight = 1.25
		return body
	end
	local charBody = infoCard("PERSONNAGE", 158)
	local sessionBody = infoCard("SESSION", 110)
	local statBody = infoCard("STATS DU JEU (leaderstats)", 130)

	local function row(key, value)
		return string.format('<font color="%s">%s</font>  %s', UI.hex(c.dim), key, tostring(value))
	end

	local function update()
		local _, hum, hrp = ctx.GetChar()
		charBody.Text = table.concat({
			row("Nom        :", player.Name .. "  (" .. player.DisplayName .. ")"),
			row("UserId     :", player.UserId),
			row("Âge compte :", player.AccountAge .. " jours"),
			row("Santé      :", hum and string.format("%d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth)) or "-"),
			row("WalkSpeed  :", hum and math.floor(hum.WalkSpeed) or "-"),
			row("Position   :", hrp and string.format("%d, %d, %d", math.floor(hrp.Position.X), math.floor(hrp.Position.Y), math.floor(hrp.Position.Z)) or "-"),
			row("FPS        :", math.floor(ctx.FPS)),
		}, "\n")
		sessionBody.Text = table.concat({
			row("Temps      :", UI.fmtTime(os.time() - startTime)),
			row("Joueurs    :", #Players:GetPlayers() .. " / " .. Players.MaxPlayers),
			row("PlaceId    :", game.PlaceId),
			row("Serveur    :", string.sub(game.JobId, 1, 8)),
		}, "\n")
		local lines = {}
		local ls = player:FindFirstChild("leaderstats")
		if ls then
			for _, v in ipairs(ls:GetChildren()) do
				if v:IsA("ValueBase") and #lines < 6 then lines[#lines + 1] = row(v.Name .. " :", v.Value) end
			end
		end
		statBody.Text = #lines > 0 and table.concat(lines, "\n") or "Ce jeu n'expose pas de leaderstats."
	end

	task.spawn(function()
		while ctx.Alive do
			task.wait(0.3)
			if group.Visible then pcall(update) end
		end
	end)
	update()
	return group
end

