-- CONFIG + CONTEXTE
----------------------------------------------------------------------
local CONFIG = {
	Name = "FRONT HUB",
	Version = "2.0",
	WalkSpeedMin = 8,
	WalkSpeedMax = 100,
	WalkSpeedDefault = 16,
	FlyMin = 10,
	FlyMax = 300,
	MaxResolution = 256,
	MaxParts = 20000,
	TargetSize = 40,
	Distance = 30,
	RowDelay = 0.03,
}
local c = UI.colors

local ctx = {
	Config = CONFIG,
	UI = UI,
	Flags = { Fly = false, Noclip = false, ClickTp = false, WalkSpeed = nil, BuildParts = 0 },
	Settings = { Animations = true, Notifications = true, UIScale = 1 },
	Alive = true,
	Saved = {}, -- positions sauvegardées (1..3)
	FPS = 60,
	Bind = bind,
	Cleanups = {},
}

function ctx.OnCleanup(fn)
	ctx.Cleanups[#ctx.Cleanups + 1] = fn
end

function ctx.GetChar()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	return char, hum, hrp
end

function ctx.TeleportTo(cf)
	local char, _, hrp = ctx.GetChar()
	if not (char and hrp) then
		ctx.Toast("Personnage indisponible", "bad")
		return false
	end
	char:PivotTo(cf)
	return true
end

do
	local _, _, hrp = ctx.GetChar()
	ctx.StartCFrame = hrp and hrp.CFrame or CFrame.new(0, 10, 0)
end

bind(RunService.RenderStepped, function(dt)
	if dt > 0 then
		ctx.FPS = ctx.FPS * 0.9 + (1 / dt) * 0.1
	end
end)

----------------------------------------------------------------------
-- PAGE : MAIN
----------------------------------------------------------------------
local function PageMain(ctx, parent)
	local UI = ctx.UI
	local c = UI.colors
	local group, scroll = UI.page(parent)
	local startTime = os.time()
	local gameName = "..."

	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(game.PlaceId)
		end)
		if ok and info and info.Name then gameName = info.Name end
	end)

	local hero = UI.card(scroll, 62)
	UI.label(hero, "TABLEAU DE BORD", {
		Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 22), TextSize = 18, Font = UI.fontBold,
	})
	local welcome = UI.label(hero, "", {
		Position = UDim2.new(0, 14, 0, 34), Size = UDim2.new(1, -28, 0, 18), TextSize = 12, TextColor3 = c.dim,
	})

	local function tiles(card, captions)
		local values = {}
		local n = #captions
		for i, caption in ipairs(captions) do
			local f = Instance.new("Frame")
			f.BackgroundColor3 = c.item
			f.BorderSizePixel = 0
			f.Size = UDim2.new(1 / n, -6, 1, -16)
			f.Position = UDim2.new((i - 1) / n, 3, 0, 8)
			f.Parent = card
			UI.corner(f, 6)
			UI.label(f, caption, {
				Position = UDim2.new(0, 8, 0, 6), Size = UDim2.new(1, -16, 0, 14), TextSize = 11, TextColor3 = c.dim,
			})
			local v = UI.label(f, "0", {
				Position = UDim2.new(0, 8, 0, 24), Size = UDim2.new(1, -16, 0, 26), TextSize = 18, Font = UI.fontBold,
			})
			UI.accentize(v, "TextColor3")
			values[i] = v
		end
		return values
	end

	local tileCard = UI.card(scroll, 74)
	local tv = tiles(tileCard, { "SESSION", "FPS", "PING", "JOUEURS" })

	-- État des fonctionnalités
	local featCard = UI.card(scroll, 106)
	UI.label(featCard, "ÉTAT DES FONCTIONNALITÉS", {
		Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 16), TextSize = 12, TextColor3 = c.dim,
	})
	local FEATURES = { "FLY", "NOCLIP", "CTRL+CLIC TP", "WALKSPEED", "IMAGE (PIXELS)", "VITESSE FLY" }
	local featValues = {}
	for i, name in ipairs(FEATURES) do
		local col = (i - 1) % 2
		local row = math.floor((i - 1) / 2)
		local cell = Instance.new("Frame")
		cell.BackgroundTransparency = 1
		cell.Position = UDim2.new(col * 0.5, col == 0 and 14 or 6, 0, 30 + row * 22)
		cell.Size = UDim2.new(0.5, -20, 0, 20)
		cell.Parent = featCard
		UI.label(cell, name, { Size = UDim2.new(0.6, 0, 1, 0), TextSize = 12 })
		featValues[i] = UI.label(cell, "", {
			Position = UDim2.new(0.6, 0, 0, 0), Size = UDim2.new(0.4, 0, 1, 0), TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
		})
	end

	local function onoff(v)
		if v then
			return '<font color="' .. UI.hex(c.good) .. '">ON</font>'
		end
		return '<font color="' .. UI.hex(c.bad) .. '">OFF</font>'
	end

	-- Stats du jeu (leaderstats : Gold, Level... si le jeu en a)
	local statCard = UI.card(scroll, 130)
	UI.label(statCard, "STATS DU JEU (leaderstats)", {
		Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 16), TextSize = 12, TextColor3 = c.dim,
	})
	local statBody = UI.label(statCard, "", {
		Position = UDim2.new(0, 14, 0, 30), Size = UDim2.new(1, -28, 1, -38), TextSize = 13,
	})

	local function getPing()
		local ok, value = pcall(function()
			return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
		end)
		if ok and value then return math.floor(value) end
		return nil
	end

	local function update()
		welcome.Text = string.format("Bienvenue, %s  •  Jeu : %s", player.DisplayName, gameName)
		tv[1].Text = UI.fmtTime(os.time() - startTime)
		tv[2].Text = tostring(math.floor(ctx.FPS))
		local ping = getPing()
		tv[3].Text = ping and (ping .. " ms") or "-"
		tv[4].Text = tostring(#Players:GetPlayers())

		featValues[1].Text = onoff(ctx.Flags.Fly)
		featValues[2].Text = onoff(ctx.Flags.Noclip)
		featValues[3].Text = onoff(ctx.Flags.ClickTp)
		featValues[4].Text = ctx.Flags.WalkSpeed and tostring(ctx.Flags.WalkSpeed) or '<font color="' .. UI.hex(c.dim) .. '">défaut</font>'
		featValues[5].Text = ctx.Flags.BuildParts > 0 and (ctx.Flags.BuildParts .. " pièces") or onoff(false)
		featValues[6].Text = tostring(ctx.Flags.FlySpeed or 50)

		local lines = {}
		local ls = player:FindFirstChild("leaderstats")
		if ls then
			for _, v in ipairs(ls:GetChildren()) do
				if v:IsA("ValueBase") and #lines < 6 then
					lines[#lines + 1] = string.format('<font color="%s">%s</font>  %s', UI.hex(c.dim), v.Name, tostring(v.Value))
				end
			end
		end
		statBody.Text = #lines > 0 and table.concat(lines, "\n") or "Ce jeu n'expose pas de leaderstats."
	end

	task.spawn(function()
		while ctx.Alive do
			task.wait(0.5)
			if group.Visible then pcall(update) end
		end
	end)
	update()
	return group
end

----------------------------------------------------------------------
-- PAGE : MOVEMENT
----------------------------------------------------------------------
local function PageMovement(ctx, parent)
	local UI = ctx.UI
	local c = UI.colors
	local cfg = ctx.Config
	local group, scroll = UI.page(parent)

	local flySpeed = 50
	ctx.Flags.FlySpeed = flySpeed
	local walkSpeed = cfg.WalkSpeedDefault
	local customWalk = false
	local upHeld, downHeld = false, false
	local bodyVel, bodyGyro, flyConn, noclipConn

	do
		local _, hum = ctx.GetChar()
		if hum then
			walkSpeed = math.clamp(math.floor(hum.WalkSpeed + 0.5), cfg.WalkSpeedMin, cfg.WalkSpeedMax)
		end
	end

	-- FLY
	local flyCard = UI.card(scroll, 118)
	UI.label(flyCard, "FLY", {
		Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(0.5, 0, 0, 18), TextSize = 14, Font = UI.fontBold,
	})
	local flyBtn, speedLabel

	local function stopFly()
		ctx.Flags.Fly = false
		if flyConn then flyConn:Disconnect() flyConn = nil end
		if bodyVel then bodyVel:Destroy() bodyVel = nil end
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
		local _, hum = ctx.GetChar()
		if hum then hum.PlatformStand = false end
		if flyBtn then UI.setOn(flyBtn, false, "FLY : ON", "FLY : OFF") end
	end

	local function startFly()
		local _, hum, hrp = ctx.GetChar()
		if not (hrp and hum) then
			ctx.Toast("Personnage indisponible", "bad")
			return
		end
		ctx.Flags.Fly = true
		hum.PlatformStand = true

		bodyVel = Instance.new("BodyVelocity")
		bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bodyVel.Velocity = Vector3.zero
		bodyVel.Parent = hrp

		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bodyGyro.P = 9e4
		bodyGyro.CFrame = hrp.CFrame
		bodyGyro.Parent = hrp

		flyConn = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			if not (cam and hrp.Parent and bodyVel and bodyGyro) then return end
			local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			local flatRight = Vector3.new(right.X, 0, right.Z)
			if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
			if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end

			local move = hum.MoveDirection -- clavier ET joystick mobile
			local vel = look * move:Dot(flatLook) + right * move:Dot(flatRight)

			local up = 0
			if upHeld or UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then up += 1 end
			if downHeld or UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.Q) then up -= 1 end

			bodyVel.Velocity = vel * flySpeed + Vector3.new(0, up * flySpeed, 0)
			bodyGyro.CFrame = cam.CFrame
		end)
		UI.setOn(flyBtn, true, "FLY : ON", "FLY : OFF")
	end

	local function toggleFly()
		if ctx.Flags.Fly then stopFly() else startFly() end
	end

	flyBtn = UI.button(flyCard, "FLY : OFF", { Position = UDim2.new(0, 14, 0, 32), Size = UDim2.new(1, -28, 0, 38), TextSize = 15 })
	flyBtn.MouseButton1Click:Connect(toggleFly)

	speedLabel = UI.stepper(flyCard, 78, "VITESSE FLY", tostring(flySpeed), function()
		flySpeed = math.clamp(flySpeed - 10, cfg.FlyMin, cfg.FlyMax)
		ctx.Flags.FlySpeed = flySpeed
		speedLabel.Text = tostring(flySpeed)
	end, function()
		flySpeed = math.clamp(flySpeed + 10, cfg.FlyMin, cfg.FlyMax)
		ctx.Flags.FlySpeed = flySpeed
		speedLabel.Text = tostring(flySpeed)
	end)

	-- NOCLIP
	local noclipCard = UI.card(scroll, 52)
	local noclipBtn
	local function setNoclip(on)
		ctx.Flags.Noclip = on
		if noclipConn then noclipConn:Disconnect() noclipConn = nil end
		if on then
			noclipConn = RunService.Stepped:Connect(function()
				local char = player.Character
				if not char then return end
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then part.CanCollide = false end
				end
			end)
		end
		UI.setOn(noclipBtn, on, "ON", "OFF")
	end
	noclipBtn = UI.toggle(noclipCard, 10, "NOCLIP (traverser les murs)", false, function()
		setNoclip(not ctx.Flags.Noclip)
	end)

	-- WALKSPEED (limité entre Min et Max)
	local walkCard = UI.card(scroll, 52)
	local walkLabel
	local function applyWalk()
		if not customWalk then return end
		local _, hum = ctx.GetChar()
		if hum then hum.WalkSpeed = walkSpeed end
	end
	local function changeWalk(delta)
		walkSpeed = math.clamp(walkSpeed + delta, cfg.WalkSpeedMin, cfg.WalkSpeedMax)
		customWalk = true
		ctx.Flags.WalkSpeed = walkSpeed
		walkLabel.Text = tostring(walkSpeed)
		applyWalk()
	end
	walkLabel = UI.stepper(walkCard, 10, "WALKSPEED (" .. cfg.WalkSpeedMin .. " - " .. cfg.WalkSpeedMax .. ")", tostring(walkSpeed),
		function() changeWalk(-2) end, function() changeWalk(2) end)
	task.spawn(function()
		while ctx.Alive do
			task.wait(0.4)
			applyWalk()
		end
	end)

	-- Position rapide (emplacement 1)
	local posCard = UI.card(scroll, 58)
	local saveBtn = UI.button(posCard, "SAUVER POSITION", { Position = UDim2.new(0, 12, 0, 12), Size = UDim2.new(0.5, -18, 0, 34), TextSize = 13 })
	local backBtn = UI.button(posCard, "REVENIR", { Position = UDim2.new(0.5, 6, 0, 12), Size = UDim2.new(0.5, -18, 0, 34), TextSize = 13 })
	saveBtn.MouseButton1Click:Connect(function()
		local _, _, hrp = ctx.GetChar()
		if hrp then
			ctx.Saved[1] = hrp.CFrame
			ctx.Toast("Position sauvegardée", "good")
		end
	end)
	backBtn.MouseButton1Click:Connect(function()
		if ctx.Saved[1] then
			if ctx.TeleportTo(ctx.Saved[1]) then ctx.Toast("Retour à la position", "good") end
		else
			ctx.Toast("Aucune position sauvegardée", "bad")
		end
	end)

	-- Boutons monter / descendre (mobile)
	if UIS.TouchEnabled then
		local touchCard = UI.card(scroll, 58)
		local upBtn = UI.button(touchCard, "MONTER", { Position = UDim2.new(0, 12, 0, 12), Size = UDim2.new(0.5, -18, 0, 34), TextSize = 13 })
		local downBtn = UI.button(touchCard, "DESCENDRE", { Position = UDim2.new(0.5, 6, 0, 12), Size = UDim2.new(0.5, -18, 0, 34), TextSize = 13 })
		upBtn.MouseButton1Down:Connect(function() upHeld = true end)
		upBtn.MouseButton1Up:Connect(function() upHeld = false end)
		upBtn.MouseLeave:Connect(function() upHeld = false end)
		downBtn.MouseButton1Down:Connect(function() downHeld = true end)
		downBtn.MouseButton1Up:Connect(function() downHeld = false end)
		downBtn.MouseLeave:Connect(function() downHeld = false end)
	end

	local note = UI.card(scroll, 48)
	UI.label(note, "Touche F = fly  •  Z/Q/S/D bouger  •  Espace/E monter  •  Shift/Q descendre", {
		Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 1, -16), TextSize = 12, TextColor3 = c.dim,
	})

	ctx.Bind(UIS.InputBegan, function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.F then toggleFly() end
	end)
	ctx.Bind(player.CharacterAdded, function() stopFly() end)

	ctx.OnCleanup(function()
		stopFly()
		if noclipConn then noclipConn:Disconnect() noclipConn = nil end
	end)

	return group
end

----------------------------------------------------------------------
-- PAGE : TELEPORT
----------------------------------------------------------------------
local function PageTeleport(ctx, parent)
	local UI = ctx.UI
	local c = UI.colors
	local group, scroll = UI.page(parent)
	local mouse = player:GetMouse()

	-- Retour au départ
	local homeCard = UI.card(scroll, 58)
	local homeBtn = UI.button(homeCard, "RETOUR AU POINT DE DÉPART", {
		Position = UDim2.new(0, 12, 0, 12), Size = UDim2.new(1, -24, 0, 34), TextSize = 14,
	})
	homeBtn.MouseButton1Click:Connect(function()
		local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		local cf = spawn and (spawn.CFrame * CFrame.new(0, spawn.Size.Y / 2 + 4, 0)) or ctx.StartCFrame
		if ctx.TeleportTo(cf) then ctx.Toast("Retour au point de départ", "good") end
	end)

	-- Liste des joueurs
	local listCard = UI.card(scroll, 210)
	UI.label(listCard, "JOUEURS (clique pour te téléporter)", {
		Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 16), TextSize = 12, TextColor3 = c.dim,
	})
	local list = Instance.new("ScrollingFrame")
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.new(0, 10, 0, 30)
	list.Size = UDim2.new(1, -20, 1, -40)
	list.ScrollBarThickness = 3
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.Parent = listCard
	UI.accentize(list, "ScrollBarImageColor3")
	UI.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.Name, Parent = list })
	UI.new("UIPadding", { PaddingRight = UDim.new(0, 6), Parent = list })

	local function refreshPlayers()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then
				local b = UI.button(list, plr.DisplayName .. "  (@" .. plr.Name .. ")", { Size = UDim2.new(1, 0, 0, 30), TextSize = 12 })
				b.Name = plr.Name
				b.MouseButton1Click:Connect(function()
					local char = plr.Character
					local target = char and char:FindFirstChild("HumanoidRootPart")
					if target then
						if ctx.TeleportTo(target.CFrame * CFrame.new(0, 0, 3)) then
							ctx.Toast("TP vers " .. plr.DisplayName, "good")
						end
					else
						ctx.Toast("Joueur introuvable", "bad")
					end
				end)
			end
		end
	end
	ctx.Bind(Players.PlayerAdded, refreshPlayers)
	ctx.Bind(Players.PlayerRemoving, function() task.defer(refreshPlayers) end)
	refreshPlayers()

	-- Ctrl + Clic
	local clickCard = UI.card(scroll, 52)
	local clickBtn
	clickBtn = UI.toggle(clickCard, 10, "CTRL + CLIC = TÉLÉPORTATION", false, function()
		ctx.Flags.ClickTp = not ctx.Flags.ClickTp
		UI.setOn(clickBtn, ctx.Flags.ClickTp, "ON", "OFF")
	end)
	ctx.Bind(UIS.InputBegan, function(input, gpe)
		if gpe then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 and ctx.Flags.ClickTp and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			if mouse.Hit then
				ctx.TeleportTo(CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)))
			end
		end
	end)

	-- Positions sauvegardées
	local header = UI.card(scroll, 30)
	UI.label(header, "POSITIONS SAUVEGARDÉES", {
		Position = UDim2.new(0, 14, 0, 7), Size = UDim2.new(1, -28, 0, 16), TextSize = 12, TextColor3 = c.dim,
	})
	for slot = 1, 3 do
		local card = UI.card(scroll, 50)
		UI.label(card, "EMPLACEMENT " .. slot, { Position = UDim2.new(0, 14, 0, 16), Size = UDim2.new(0.4, 0, 0, 18), TextSize = 13 })
		local saveBtn = UI.button(card, "SAUVER", { Position = UDim2.new(1, -210, 0.5, -16), Size = UDim2.new(0, 94, 0, 32), TextSize = 12 })
		local goBtn = UI.button(card, "ALLER", { Position = UDim2.new(1, -106, 0.5, -16), Size = UDim2.new(0, 94, 0, 32), TextSize = 12 })
		saveBtn.MouseButton1Click:Connect(function()
			local _, _, hrp = ctx.GetChar()
			if hrp then
				ctx.Saved[slot] = hrp.CFrame
				ctx.Toast("Position " .. slot .. " sauvegardée", "good")
			end
		end)
		goBtn.MouseButton1Click:Connect(function()
			if ctx.Saved[slot] then
				if ctx.TeleportTo(ctx.Saved[slot]) then ctx.Toast("Retour à la position " .. slot, "good") end
			else
				ctx.Toast("Aucune position sauvegardée (" .. slot .. ")", "bad")
			end
		end)
	end

	return group
end

----------------------------------------------------------------------
-- PAGE : BUILDER (image -> pixels, visible uniquement par toi)
----------------------------------------------------------------------
local function PageBuilder(ctx, parent)
	local UI = ctx.UI
	local c = UI.colors
	local cfg = ctx.Config
	local group, scroll = UI.page(parent)

	-- Résolutions disponibles (nombre de pixels max par côté) : plus = image plus détaillée
	local RESOLUTIONS = { 16, 24, 32, 48, 64, 96, 128, 192, 256 }
	local resIndex = 5 -- 64 par défaut
	local sizeStuds = cfg.TargetSize
	local compress = true
	local busy = false
	local token = 0

	-- Lien de l'image
	local urlCard = UI.card(scroll, 78)
	UI.label(urlCard, "LIEN DE L'IMAGE (jpg, png, webp...)", {
		Position = UDim2.new(0, 14, 0, 8), Size = UDim2.new(1, -28, 0, 16), TextSize = 12, TextColor3 = c.dim,
	})
	local urlBox = UI.input(urlCard, { Placeholder = "https://...", Position = UDim2.new(0, 14, 0, 30), Size = UDim2.new(1, -28, 0, 36) })

	-- Nombre de pixels
	local resCard = UI.card(scroll, 52)
	local resLabel
	local function setRes(delta)
		resIndex = math.clamp(resIndex + delta, 1, #RESOLUTIONS)
		resLabel.Text = tostring(RESOLUTIONS[resIndex])
	end
	resLabel = UI.stepper(resCard, 10, "NOMBRE DE PIXELS (max par côté)", tostring(RESOLUTIONS[resIndex]),
		function() setRes(-1) end, function() setRes(1) end)

	-- Taille de l'image dans le jeu
	local sizeCard = UI.card(scroll, 52)
	local sizeLabel
	local function setSize(delta)
		sizeStuds = math.clamp(sizeStuds + delta, 20, 200)
		sizeLabel.Text = tostring(sizeStuds)
	end
	sizeLabel = UI.stepper(sizeCard, 10, "TAILLE DANS LE JEU (studs)", tostring(sizeStuds),
		function() setSize(-10) end, function() setSize(10) end)

	-- Compression des couleurs
	local compCard = UI.card(scroll, 52)
	UI.toggle(compCard, 10, "COMPRESSION (moins de pièces)", compress, function(btn)
		compress = not compress
		UI.setOn(btn, compress, "ON", "OFF")
	end)

	-- Actions
	local actionCard = UI.card(scroll, 58)
	local buildBtn = UI.button(actionCard, "CONSTRUIRE", { Position = UDim2.new(0, 12, 0, 12), Size = UDim2.new(0.5, -18, 0, 34), TextSize = 14 })
	local clearBtn = UI.button(actionCard, "EFFACER", { Position = UDim2.new(0.5, 6, 0, 12), Size = UDim2.new(0.5, -18, 0, 34), TextSize = 14 })

	-- Statut
	local statusCard = UI.card(scroll, 100)
	local status = UI.label(statusCard, "", {
		Position = UDim2.new(0, 14, 0, 10), Size = UDim2.new(1, -28, 1, -30), TextSize = 12, TextColor3 = c.dim,
	})
	local statusBar = UI.bar(statusCard, { Position = UDim2.new(0, 14, 1, -18), Size = UDim2.new(1, -28, 0, 6) })
	local function setStatus(text, level)
		status.Text = text
		status.TextColor3 = (level == "good" and c.good) or (level == "bad" and c.bad) or c.dim
	end
	setStatus("Colle un lien direct vers une image (ou une page Bing Images) puis clique sur CONSTRUIRE.\nPlus de pixels = image plus détaillée, mais plus longue à construire (128+ peut prendre quelques secondes). Visible uniquement par toi.")

	local function clearPixels()
		token += 1
		local f = workspace:FindFirstChild("FrontHubV2_Pixels")
		if f then f:Destroy() end
		ctx.Flags.BuildParts = 0
	end
	ctx.OnCleanup(clearPixels)

	local function httpGetBinary(url)
		local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
		local lastStatus, lastErr
		if req then
			local ok, res = pcall(req, { Url = url, Method = "GET" })
			if ok and res then
				if res.Body and (res.StatusCode == nil or res.StatusCode == 200) then return res.Body end
				lastStatus, lastErr = res.StatusCode, res.Body
			elseif not ok then
				lastErr = tostring(res)
			end
		end
		local ok, body = pcall(function() return game:HttpGet(url) end)
		if ok and body then return body end
		if not ok then lastErr = tostring(body) end
		return nil, lastStatus, lastErr
	end

	local function fetchPNG(link, res)
		local enc = HttpService:UrlEncode(link)
		local bare = link:gsub("^https?://", "")
		local candidates = {
			string.format("https://wsrv.nl/?url=%s&w=%d&h=%d&fit=inside&output=png", enc, res, res),
			string.format("https://images.weserv.nl/?url=%s&w=%d&h=%d&fit=inside&output=png", enc, res, res),
			string.format("https://images.weserv.nl/?url=%s&w=%d&h=%d&fit=inside&output=png", HttpService:UrlEncode(bare), res, res),
		}
		local lastErr = "aucune réponse (HTTP bloqué par ton executor ?)"
		for _, u in ipairs(candidates) do
			local body, st, err = httpGetBinary(u)
			if body and body:sub(1, 8) == PNGDecoder.Signature then
				return body
			elseif body then
				lastErr = "réponse reçue mais ce n'est pas une image : " .. (body:sub(1, 80):gsub("%c", " "))
			elseif err then
				lastErr = string.format("erreur %s : %s", tostring(st), (tostring(err):sub(1, 80):gsub("%c", " ")))
			end
		end
		return nil, lastErr
	end

	local function buildImage()
		local link = urlBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if link == "" then
			ctx.Toast("Colle d'abord un lien d'image", "bad")
			return
		end
		local media = link:match("mediaurl=([^&]+)")
		if media then
			link = (media:gsub("%%(%x%x)", function(hex) return string.char(tonumber(hex, 16)) end))
		end
		local _, _, hrp = ctx.GetChar()
		if not hrp then
			ctx.Toast("Personnage indisponible", "bad")
			return
		end

		clearPixels()
		local myToken = token
		local resolution = RESOLUTIONS[resIndex]
		statusBar.Set(0)
		setStatus("Téléchargement de l'image (" .. resolution .. " px max)...", "info")
		local body, err = fetchPNG(link, resolution)
		if myToken ~= token then return end
		if not body then
			setStatus("Téléchargement impossible : " .. tostring(err), "bad")
			return
		end

		setStatus("Décodage de l'image...", "info")
		local ok, w, h, getPixel = pcall(PNGDecoder.decode, body)
		if myToken ~= token then return end
		if not ok then
			setStatus("Image illisible : " .. tostring(w), "bad")
			return
		end

		-- Fusion en rectangles : les pixels identiques voisins (horizontalement ET verticalement)
		-- deviennent une seule pièce, ce qui permet beaucoup plus de pixels avec peu de pièces.
		setStatus("Optimisation des pixels (" .. w .. "x" .. h .. ")...", "info")
		local step = compress and 8 or 1
		local function quant(v)
			if step == 1 then return v end
			return math.min(255, math.floor(v / step + 0.5) * step)
		end

		local rects, open = {}, {}
		for y = 1, h do
			local nextOpen = {}
			local x = 1
			while x <= w do
				local r, g, b, a = getPixel(x, y)
				if a >= 128 then
					r, g, b = quant(r), quant(g), quant(b)
					local x2 = x
					while x2 < w do
						local r2, g2, b2, a2 = getPixel(x2 + 1, y)
						if a2 >= 128 and quant(r2) == r and quant(g2) == g and quant(b2) == b then
							x2 += 1
						else
							break
						end
					end
					local key = x .. ":" .. x2 .. ":" .. r .. ":" .. g .. ":" .. b
					local rect = open[key]
					if rect then
						rect.y2 = y
					else
						rect = { x1 = x, x2 = x2, y1 = y, y2 = y, r = r, g = g, b = b }
						rects[#rects + 1] = rect
					end
					nextOpen[key] = rect
					x = x2 + 1
				else
					x += 1
				end
			end
			open = nextOpen
			if y % 16 == 0 then
				task.wait()
				if myToken ~= token then return end
			end
		end

		local count = #rects
		if count == 0 then
			setStatus("L'image est vide ou transparente", "bad")
			return
		end
		if count > cfg.MaxParts then
			setStatus(string.format("Trop de pièces (%d, max %d). Active la COMPRESSION ou baisse le nombre de pixels.", count, cfg.MaxParts), "bad")
			return
		end

		-- Regroupe les rectangles par ligne de départ (pour l'animation de haut en bas)
		local byRow = {}
		for _, rect in ipairs(rects) do
			byRow[rect.y1] = byRow[rect.y1] or {}
			table.insert(byRow[rect.y1], rect)
		end

		local folder = Instance.new("Folder")
		folder.Name = "FrontHubV2_Pixels"
		folder.Parent = workspace

		local ps = sizeStuds / math.max(w, h) -- taille d'un pixel en studs
		local pos = hrp.Position
		local center = pos + hrp.CFrame.LookVector * math.max(cfg.Distance, sizeStuds * 0.75) + Vector3.new(0, (h * ps) / 2 - 2, 0)
		local base = CFrame.lookAt(center, Vector3.new(pos.X, center.Y, pos.Z))
		local rowDelay = math.min(cfg.RowDelay, 5 / h) -- animation de 5 s maximum

		for y = 1, h do
			if myToken ~= token or not folder.Parent then return end
			local list = byRow[y]
			if list then
				for _, rect in ipairs(list) do
					local part = Instance.new("Part")
					part.Anchored = true
					part.CanCollide = false
					part.CanQuery = false
					part.CanTouch = false
					part.Locked = true
					part.Material = Enum.Material.SmoothPlastic
					part.Color = Color3.fromRGB(rect.r, rect.g, rect.b)
					part.Size = Vector3.new((rect.x2 - rect.x1 + 1) * ps, (rect.y2 - rect.y1 + 1) * ps, 0.5)
					local centerCol = (rect.x1 + rect.x2) / 2
					local centerRow = (rect.y1 + rect.y2) / 2
					part.CFrame = base * CFrame.new(-(centerCol - (w + 1) / 2) * ps, (h / 2 - centerRow + 0.5) * ps, 0)
					part.Parent = folder
				end
			end
			if y % 4 == 0 or h <= 64 then
				statusBar.Set(y / h)
				setStatus(string.format("Construction... %d%%", math.floor(y / h * 100)), "info")
			end
			task.wait(rowDelay)
		end
		statusBar.Set(1)
		ctx.Flags.BuildParts = count
		setStatus(string.format("Terminé ! Image %dx%d = %d pixels construits avec %d pièces. Visible uniquement par toi.", w, h, w * h, count), "good")
		ctx.Toast("Image construite", "good")
	end

	buildBtn.MouseButton1Click:Connect(function()
		if busy then return end
		busy = true
		UI.setOn(buildBtn, true, "EN COURS...", "CONSTRUIRE")
		task.spawn(function()
			local ok, err = pcall(buildImage)
			if not ok then setStatus("Erreur : " .. tostring(err), "bad") end
			busy = false
			UI.setOn(buildBtn, false, "EN COURS...", "CONSTRUIRE")
		end)
	end)
	clearBtn.MouseButton1Click:Connect(function()
		clearPixels()
		statusBar.Set(0)
		setStatus("Image effacée.", "info")
	end)

	return group
end

