	Name = "Toasts", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14),
	Size = UDim2.new(0, 300, 1, -28), BackgroundTransparency = 1, Parent = gui,
})
UI.new("UIListLayout", {
	Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
	VerticalAlignment = Enum.VerticalAlignment.Top, Parent = toastHolder,
})
local toastOrder = 0

function ctx.Toast(message, level)
	if not ctx.Settings.Notifications or not message then return end
	local color = UI.accent
	if level == "good" then color = c.good elseif level == "bad" then color = c.bad elseif level == "warn" then color = c.warn end

	local existing = {}
	for _, child in ipairs(toastHolder:GetChildren()) do
		if child:IsA("Frame") then existing[#existing + 1] = child end
	end
	if #existing >= 5 then existing[1]:Destroy() end

	toastOrder += 1
	local wrap = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, ClipsDescendants = true,
		LayoutOrder = toastOrder, Parent = toastHolder,
	})
	local card = UI.new("Frame", {
		Position = UDim2.new(1, 30, 0, 0), Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = c.panel, BorderSizePixel = 0, Parent = wrap,
	})
	UI.corner(card, 6)
	UI.rawStroke(card, color, 1.2, 0.2)
	local bar = UI.new("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = color, BorderSizePixel = 0, Parent = card })
	UI.corner(bar, 2)
	UI.label(card, tostring(message), {
		Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -18, 1, 0), TextSize = 13,
		TextYAlignment = Enum.TextYAlignment.Center,
	})
	UI.tween(card, 0.25, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)

	task.delay(3.2, function()
		if wrap.Parent then
			UI.tween(card, 0.25, { Position = UDim2.new(1, 30, 0, 0) })
			task.wait(UI.animations and 0.27 or 0)
			wrap:Destroy()
		end
	end)
end

