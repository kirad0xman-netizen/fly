-- BOUTONS DE LA FENÊTRE
----------------------------------------------------------------------
minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	minBtn.Text = minimized and "+" or "-"
	if minimized then
		side.Visible = false
		content.Visible = false
	end
	local tw = UI.tween(window, 0.25, { Size = minimized and MINI or FULL })
	local function restore()
		if not minimized then
			side.Visible = true
			content.Visible = true
		end
	end
	if tw then tw.Completed:Connect(restore) else restore() end
end)

closeBtn.MouseButton1Click:Connect(function()
	setOpen(false)
end)

-- Bouton flottant pour ouvrir / fermer (utile sur mobile)
local launcher = UI.button(gui, "FH", {
	Position = UDim2.new(0, 10, 0.5, -22), Size = UDim2.new(0, 44, 0, 44), TextSize = 16, Font = UI.fontTitle,
})
launcher.MouseButton1Click:Connect(function()
	setOpen(not isOpen)
end)

bind(UIS.InputBegan, function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		setOpen(not isOpen)
	end
end)

-- Déplacement de la fenêtre (souris et tactile)
local dragging, dragStart, startPos
top.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = window.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
bind(UIS.InputChanged, function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

----------------------------------------------------------------------
-- NETTOYAGE (relancer le script ou bouton "Supprimer le hub")
----------------------------------------------------------------------
local function cleanup()
	ctx.Alive = false
	for _, fn in ipairs(ctx.Cleanups) do
		pcall(fn)
	end
	for _, cn in ipairs(conns) do
		pcall(function() cn:Disconnect() end)
	end
	pcall(UI.Destroy)
	pcall(function() gui:Destroy() end)
	local pix = workspace:FindFirstChild("FrontHubV2_Pixels")
	if pix then pix:Destroy() end
	env.FrontHubV2Cleanup = nil
end
ctx.Destroy = cleanup
env.FrontHubV2Cleanup = cleanup

