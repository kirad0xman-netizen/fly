local function selectTab(id)
	if currentTab == id then return end
	local oldPage = currentTab and pages[currentTab]
	currentTab = id

	for tabId, b in pairs(tabButtons) do
		UI.tween(b, 0.2, { TextColor3 = (tabId == id) and UI.accent or c.dim })
		if tabId == id then
			UI.tween(indicator, 0.25, { Position = UDim2.new(0, 0, 0, b.Position.Y.Offset + 4) }, Enum.EasingStyle.Back)
		end
	end

	if oldPage then
		UI.tween(oldPage, 0.15, { GroupTransparency = 1 })
		task.delay(UI.animations and 0.15 or 0, function()
			if pages[currentTab] ~= oldPage then oldPage.Visible = false end
		end)
	end
	local page = pages[id]
	page.Visible = true
	page.Position = UDim2.new(0, UI.animations and 16 or 0, 0, 0)
	page.GroupTransparency = UI.animations and 1 or 0
	UI.tween(page, 0.25, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })
end

